# Copia este fichero a .env y rellénalo.
# SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ADMIN_USERNAME=admin
# python scripts/hash_password.py → valor en base64 (sin "$", válido también en Portainer)
ADMIN_PASSWORD_HASH=
# true si sirves PashtAPP detrás de HTTPS (p. ej. tailscale serve)
COOKIE_SECURE=false
